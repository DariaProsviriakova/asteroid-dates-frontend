{
  "name": "asteroid-dates-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "ЛР6 — пользовательский интерфейс каталога дат сближения астероидов",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-backend-types": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "swagger-typescript-api": "^13.14.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "swaggerCodegen": {
    "input": "openapi/asteroid-dates.json",
    "output": "src/api/generated",
    "fileName": "AsteroidDatesApi.ts",
    "httpClientType": "axios",
    "generateClient": true,
    "extractRequestParams": true,
    "unwrapResponseData": false,
    "operationIds": [
      "listPublishedDates",
      "getFeedDate",
      "getCurrentDraft",
      "createDraft",
      "publishDraft",
      "setLike"
    ]
  }
}
